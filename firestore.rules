rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && (request.auth.token.email_verified == true
          || request.auth.token.get('stockwise_legacy_account', false) == true);
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function memberPath(storeId) {
      return /databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid);
    }

    function isActiveMember(storeId) {
      return signedIn()
        && exists(memberPath(storeId))
        && get(memberPath(storeId)).data.isActive == true;
    }

    function hasStoreRole(storeId, roles) {
      return isActiveMember(storeId)
        && get(memberPath(storeId)).data.role in roles;
    }

    function managesInventory(storeId) {
      return hasStoreRole(storeId, ['owner', 'admin', 'manager', 'staff']);
    }

    function managesStore(storeId) {
      return hasStoreRole(storeId, ['owner', 'admin']);
    }

    function validReportSchedules(data) {
      return !data.keys().hasAny(['reportEmailSchedules'])
        || (data.reportEmailSchedules is map
          && data.reportEmailSchedules.keys().hasOnly(['sales', 'waste'])
          && data.reportEmailSchedules.keys().hasAll(['sales', 'waste'])
          && data.reportEmailSchedules.sales is list
          && data.reportEmailSchedules.waste is list
          && data.reportEmailSchedules.sales.size() <= 4
          && data.reportEmailSchedules.waste.size() <= 4
          && data.reportEmailSchedules.sales.hasOnly(['daily', 'weekly', 'monthly', 'yearly'])
          && data.reportEmailSchedules.waste.hasOnly(['daily', 'weekly', 'monthly', 'yearly']));
    }

    function isBootstrapOwner(storeId) {
      return signedIn()
        && getAfter(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid
          == request.auth.uid;
    }

    function validCartItem(storeId, batchId) {
      let batch = get(/databases/$(database)/documents/stores/$(storeId)/inventoryBatches/$(batchId)).data;
      let sellingPrice = batch.promotionEnabled == true
        && batch.promotionPriceCents != null
          ? batch.promotionPriceCents
          : batch.basePriceCents;
      return request.resource.data.storeId == storeId
        && request.resource.data.batchId == batchId
        && request.resource.data.productId == batch.productId
        && request.resource.data.productName == batch.productName
        && request.resource.data.imagePath == batch.get('imagePath', null)
        && request.resource.data.expiryAt == batch.expiryAt
        && batch.status == 'active' && batch.expiryAt > request.time
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.quantity
          <= batch.quantityOnHand - batch.quantityReserved
        && request.resource.data.unitPriceCents == sellingPrice;
    }

    function chatReadable(storeId, customerId) {
      return owns(customerId) || managesStore(storeId);
    }

    function validChatAttachment(storeId, customerId, messageId, data) {
      return data is map
        && data.keys().hasOnly(['storagePath', 'fileName', 'contentType', 'size'])
        && data.storagePath == 'stores/' + storeId + '/chat-attachments/' + customerId + '/' + request.auth.uid + '/' + messageId + '/file'
        && data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 180
        && data.contentType is string && data.contentType.size() <= 120
        && data.contentType.matches('[A-Za-z0-9.+_-]+/[A-Za-z0-9.+_-]+')
        && data.size is int && data.size > 0 && data.size <= 20 * 1024 * 1024;
    }

    function chatPreviewText(message) {
      return message.text.size() > 0 ? message.text
        : (message.attachment.contentType.matches('image/.*') ? 'Photo: ' : 'File: ') + message.attachment.fileName;
    }

    function validChatMessage(storeId, customerId, messageId, data) {
      return signedIn()
        && data.keys().hasOnly(['senderId', 'senderName', 'senderRole', 'text', 'sentAt', 'attachment'])
        && data.senderId == request.auth.uid
        && ((managesStore(storeId) && data.senderRole == 'admin')
          || (!managesStore(storeId) && owns(customerId) && data.senderRole == 'customer'))
        && data.senderName is string
        && data.senderName.size() > 0 && data.senderName.size() <= 80
        && data.senderName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        && data.text is string && data.text.size() <= 2000
        && (data.text.matches('(?s).*\\S.*') || data.keys().hasAny(['attachment']))
        && (!data.keys().hasAny(['attachment']) || validChatAttachment(storeId, customerId, messageId, data.attachment))
        && data.sentAt == request.time;
    }

    function validChatPreview(storeId, customerId) {
      let data = request.resource.data;
      let path = /databases/$(database)/documents/stores/$(storeId)/conversations/$(customerId)/messages/$(data.lastMessageId);
      let message = getAfter(path).data;
      return data.lastMessageId is string
        && !exists(path)
        && data.lastMessage == chatPreviewText(message)
        && data.lastMessageAt == message.sentAt
        && data.lastSenderId == message.senderId
        && data.lastSenderRole == message.senderRole
        && validChatMessage(storeId, customerId, data.lastMessageId, message);
    }

    function validChatRead(field) {
      let data = request.resource.data;
      return data.diff(resource.data).affectedKeys().hasOnly([field])
        && data[field] is timestamp && data[field] <= request.time
        && data[field] <= resource.data.lastMessageAt
        && (resource.data[field] == null || data[field] >= resource.data[field]);
    }

    // Keep these numbering ranges in sync with functions/data/malaysia_phone_patterns.json.
    function validCompactMalaysianPhone(value) {
      let prefixed = value.matches('(\\+60|0060|60|0)[0-9]+');
      let national = value.replace('^(\\+60|0060|60|0)', '');
      return value.matches('\\+?[0-9]+')
        && (prefixed || value.matches("(?:1[378]00\\d{6}|1600\\d{6})"))
        && national.matches("(?:427[01]\\d{4}|(?:3(?:2[0-36-9]|3[0-368]|4[0-278]|5[0-24-8]|6[0-467]|7[1246-9]|8\\d|9[0-57])\\d|4(?:2[0-689]|[3-79]\\d|8[1-35689])|5(?:2[0-589]|[3468]\\d|5[0-489]|7[1-9]|9[23])|6(?:2[2-9]|3[1357-9]|[46]\\d|5[0-6]|7[0-35-9]|85|9[015-8])|7(?:[2579]\\d|3[03-68]|4[0-8]|6[5-9]|8[0-35-9])|8(?:[24][2-8]|3[2-5]|5[2-7]|6[2-589]|7[2-578]|[89][2-9])|9(?:0[57]|13|[25-7]\\d|[3489][0-8]))\\d{5}|1(?:(?:1888[689]|4400|8(?:47|8[27])[0-4])\\d{4}|9\\d{7,8})|1(?:0(?:[23568]\\d|4[0-6]|7[016-9]|9[0-8])|1(?:[1-5]\\d\\d|6(?:0[5-9]|[1-9]\\d)|7(?:[0-4]\\d|5[0-79]|6[02-4]|8[02-5]))|(?:[26]\\d|[37][1-9]|4[235-9])\\d|5(?:31|9\\d\\d)|8(?:1[23]|[236]\\d|4[06]|5(?:46|[7-9])|7[016-9]|8[01]|9[0-8]))\\d{5}|15(?:4(?:6[0-4]\\d|8(?:0[125]|[17]\\d|21|3[01]|4[01589]|5[014]|6[02]))|6(?:32[0-6]|78\\d))\\d{4}|1[378]00\\d{6}|1600\\d{6})");
    }

    function validMalaysianPhone(value) {
      return value is string
        && value.trim().size() <= 64
        && value.trim().matches('[+0-9 ()-]+')
        && value.trim().matches('[^()]*(?:\\([^()]*[0-9][^()]*\\)[^()]*)*')
        && validCompactMalaysianPhone(value.trim().replace('[ ()-]', ''));
    }

    function validOptionalPhone(value) {
      return value == null || (value is string
        && (value.trim().size() == 0 || validMalaysianPhone(value)));
    }

    function nonemptyAddressText(value, maximum) {
      return value is string && value.size() <= maximum
        && value.matches('(?s).*\\S.*');
    }

    function validSavedAddress(data) {
      let line2 = data.get('addressLine2', '');
      let expectedState = get(/databases/$(database)/documents/validationData/malaysiaPostcodes).data.states.get(data.postalCode, '');
      let formatted = data.addressLine1 + (line2.size() > 0 ? '\n' + line2 : '')
        + '\n' + data.postalCode + ' ' + data.city + ', ' + data.state;
      return nonemptyAddressText(data.label, 40)
        && nonemptyAddressText(data.name, 80)
        && validMalaysianPhone(data.phone)
        && nonemptyAddressText(data.addressLine1, 200)
        && line2 is string && line2.size() <= 200
        && nonemptyAddressText(data.city, 80) && data.city.matches('[^\r\n]+')
        && nonemptyAddressText(data.state, 80) && data.state.matches('[^\r\n]+')
        && data.postalCode is string && data.postalCode.matches('[0-9]{5}')
        && expectedState.size() > 0 && data.state == expectedState
        && data.get('countryCode', 'MY') == 'MY'
        && formatted.size() <= 500;
    }

    function validShopAddress(data) {
      return data.shopAddress is string && data.shopAddress.size() <= 500
        && data.shopAddress.matches('(?s).*\\S.*');
    }

    match /storeNames/{nameKey} {
      allow read, write: if false;
    }

    // Rules may read this trusted index; clients use the bundled offline copy.
    match /validationData/{documentId} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid) && validOptionalPhone(request.resource.data.get('phoneNumber', null));
      // Legacy phone values do not block unrelated preference/address updates.
      allow update: if owns(uid)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['phoneNumber'])
          || validOptionalPhone(request.resource.data.get('phoneNumber', null)));
      allow delete: if false;

      match /addresses/{addressId} {
        allow read, delete: if owns(uid);
        allow create, update: if owns(uid) && validSavedAddress(request.resource.data);
      }

      match /devices/{deviceId} {
        allow read: if owns(uid);
        allow write: if false;
      }
    }

    match /systemStatus/reportEmail {
      allow read: if signedIn();
      allow write: if false;
    }
    match /assistantUsage/{uid} {
      allow read, write: if false;
    }

    // Authorize watchMyMemberships across all members subcollections.
    // The query must constrain userId to the signed-in user's UID.
    match /{path=**}/members/{memberId} {
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /{path=**}/adminInvites/{inviteId} {
      allow list: if signedIn()
        && resource.data.emailLowercase
          == request.auth.token.email.lower();
    }
    match /stores/{storeId} {
      allow read: if signedIn() && (resource.data.status == 'active' || isActiveMember(storeId));
      // Creation is server-only to require an address and reserve a unique name atomically.
      allow create: if false;
      allow update: if managesStore(storeId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['name', 'nameLowercase', 'nameKey', 'shopAddress', 'address', 'ownerUid', 'operatingHours', 'status'])
        && ((!resource.data.keys().hasAny(['shopAddress']) && !request.resource.data.keys().hasAny(['shopAddress']))
          || validShopAddress(request.resource.data));
      allow delete: if false;

      match /members/{uid} {
        allow get: if owns(uid) || isActiveMember(storeId);
        allow list: if (signedIn() && resource.data.userId == request.auth.uid) || isActiveMember(storeId);
        allow create: if signedIn() && (
          (owns(uid)
            && request.resource.data.role == 'owner'
            && getAfter(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid == request.auth.uid)
          || (hasStoreRole(storeId, ['owner'])
            && request.resource.data.role in ['admin', 'manager', 'staff'])
          || (owns(uid)
            && request.resource.data.role == 'admin'
            && request.auth.token.email_verified == true
            && request.resource.data.invitationId is string
            && get(/databases/$(database)/documents/stores/$(storeId)/adminInvites/$(request.resource.data.invitationId)).data.status == 'pending'
            && get(/databases/$(database)/documents/stores/$(storeId)/adminInvites/$(request.resource.data.invitationId)).data.emailLowercase
              == request.auth.token.email.lower())
        );
        allow update: if validReportSchedules(request.resource.data) && ((owns(uid) && isActiveMember(storeId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportsByEmail', 'reportEmailSchedules', 'updatedAt'])
            && request.resource.data.reportsByEmail is bool)
          || (hasStoreRole(storeId, ['owner'])
            && request.resource.data.role == resource.data.role)
          || (hasStoreRole(storeId, ['admin'])
            && resource.data.role != 'owner'
            && request.resource.data.role == resource.data.role));
        allow delete: if hasStoreRole(storeId, ['owner']) && uid != request.auth.uid;
      }

      match /adminInvites/{inviteId} {
        allow read: if managesStore(storeId)
          || (signedIn()
            && resource.data.emailLowercase
              == request.auth.token.email.lower());
        allow create: if managesStore(storeId)
          && request.resource.data.storeId == storeId
          && request.resource.data.role == 'admin'
          && request.resource.data.status == 'pending';
        allow update: if managesStore(storeId) || (
          signedIn()
          && resource.data.status == 'pending'
          && resource.data.emailLowercase
            == request.auth.token.email.lower()
          && request.resource.data.status == 'accepted'
          && request.resource.data.acceptedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'acceptedBy', 'acceptedAt', 'updatedAt'])
        );
        allow delete: if managesStore(storeId);
      }

      match /categories/{categoryId} {
        allow read: if signedIn();
        allow create, update: if (managesInventory(storeId) || isBootstrapOwner(storeId))
          && request.resource.data.storeId == storeId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.isActive is bool;
        allow delete: if false;
      }

      match /reportDeliveries/{deliveryId} {
        allow read: if managesInventory(storeId);
        allow write: if false;
      }

      match /products/{productId} {
        allow read: if signedIn();
        allow write: if managesInventory(storeId);
      }

      match /inventoryArchive/{batchId} {
        allow read: if managesInventory(storeId);
        allow write: if false;
      }
      match /expiryNotifications/{notificationId} {
        allow read, write: if false;
      }
      match /inventoryBatches/{batchId} {
        allow read: if signedIn();
        allow create: if managesInventory(storeId)
          && request.resource.data.quantityOnHand is int && request.resource.data.quantityOnHand > 0
          && request.resource.data.basePriceCents is int && request.resource.data.basePriceCents > 0;
        allow update: if managesInventory(storeId) && resource.data.expiryAt > request.time
          && request.resource.data.quantityOnHand is int && request.resource.data.quantityOnHand >= 0
          && request.resource.data.basePriceCents is int && request.resource.data.basePriceCents > 0;
        allow delete: if false;
      }
      match /inventoryEvents/{eventId} {
        allow read: if managesInventory(storeId);
        allow create: if managesInventory(storeId) && request.resource.data.eventType in ['received', 'adjusted'];
        allow update, delete: if false;
      }

      match /carts/{uid} {
        allow read: if owns(uid);
        allow create, update: if owns(uid)
          && request.resource.data.ownerUid == uid
          && request.resource.data.storeId == storeId;
        allow delete: if owns(uid) || managesStore(storeId);

        match /items/{batchId} {
          allow read, delete: if owns(uid);
          allow create: if owns(uid) && validCartItem(storeId, batchId);
          allow update: if owns(uid)
            && validCartItem(storeId, batchId)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['quantity', 'updatedAt', 'unitPriceCents', 'productName', 'imagePath', 'expiryAt']);
        }
      }

      match /orders/{orderId} {
        allow create: if false;
        allow read: if signedIn()
          && (resource.data.userId == request.auth.uid || managesInventory(storeId));
        allow update: if (
          signedIn()
          && resource.data.status == 'to_pay'
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['receiptPath', 'receiptUploadedAt', 'updatedAt'])
          && request.resource.data.receiptPath is string
          && request.resource.data.receiptPath.matches(
            'stores/' + storeId + '/order-attachments/' + orderId + '/.*'
          )
        );
        allow delete: if false;

        match /items/{itemId} {
          allow create: if false;
          allow read: if signedIn()
            && (get(/databases/$(database)/documents/stores/$(storeId)/orders/$(orderId)).data.userId
              == request.auth.uid || managesInventory(storeId));
          allow update, delete: if false;
        }
      }

      // One private customer conversation per store; active owner/admin share the inbox.
      match /conversations/{customerId} {
        allow get: if chatReadable(storeId, customerId);
        allow list: if managesStore(storeId);
        allow create: if owns(customerId) && !managesStore(storeId)
          && get(/databases/$(database)/documents/stores/$(storeId)).data.status == 'active'
          && request.resource.data.keys().hasOnly(['storeId', 'customerId', 'customerName',
            'lastMessageId', 'lastMessage', 'lastMessageAt', 'lastSenderId', 'lastSenderRole',
            'customerReadAt', 'adminReadAt'])
          && request.resource.data.storeId == storeId
          && request.resource.data.customerId == customerId
          && request.resource.data.customerName
            == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
          && request.resource.data.customerReadAt == request.time
          && request.resource.data.adminReadAt == null
          && validChatPreview(storeId, customerId);
        allow update: if (owns(customerId) && !managesStore(storeId)
            && validChatRead('customerReadAt'))
          || (managesStore(storeId) && validChatRead('adminReadAt'))
          || (validChatPreview(storeId, customerId)
            && request.resource.data.storeId == resource.data.storeId
            && request.resource.data.customerId == resource.data.customerId
            && ((managesStore(storeId)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'lastMessageId', 'lastMessage', 'lastMessageAt', 'lastSenderId', 'lastSenderRole', 'adminReadAt'])
                && request.resource.data.adminReadAt == request.time)
              || (owns(customerId) && !managesStore(storeId)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'lastMessageId', 'lastMessage', 'lastMessageAt', 'lastSenderId', 'lastSenderRole', 'customerReadAt', 'customerName'])
                && request.resource.data.customerReadAt == request.time
                && request.resource.data.customerName
                  == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName)));
        allow delete: if false;

        match /messages/{messageId} {
          allow read: if chatReadable(storeId, customerId);
          allow create: if validChatMessage(storeId, customerId, messageId, request.resource.data)
            && getAfter(/databases/$(database)/documents/stores/$(storeId)/conversations/$(customerId)).data.lastMessageId == messageId
            && getAfter(/databases/$(database)/documents/stores/$(storeId)/conversations/$(customerId)).data.lastSenderId == request.auth.uid;
          allow update, delete: if false;
        }
      }

      match /notifications/{notificationId} {
        allow create: if signedIn()
          && (request.resource.data.recipientUid == request.auth.uid || managesInventory(storeId));
        allow read: if signedIn()
          && (resource.data.recipientUid == request.auth.uid || managesInventory(storeId));
        allow update: if signedIn()
          && resource.data.recipientUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
        allow delete: if false;
      }

      match /settings/{settingId} {
        allow read: if signedIn();
        allow write: if settingId != 'commerce' && managesStore(storeId);
      }
    }
  }
}
